# ============================================================
# Environment template — copy to ".env" and fill in real values.
# .env is gitignored; this .env.example is committed as documentation.
# ============================================================

# --- LLM (via LiteLLM) ---
LLM_PROVIDER=gemini                       # gemini | openai | anthropic
GEMINI_API_KEY=your-gemini-key-here       # used when LLM_PROVIDER=gemini
LLM_MODEL=gemini/gemini-3.1-flash-lite-preview   # LiteLLM model string (same as Project 1)

# --- Embeddings ---
EMBEDDINGS_PROVIDER=local                 # local | openai | gemini
EMBEDDINGS_MODEL=all-MiniLM-L6-v2         # local sentence-transformers model

# --- Vector store (ChromaDB) ---
CHROMA_DIR=./chroma_data                  # local persistent directory

# --- Database (PostgreSQL, for Text-to-SQL) ---
DATABASE_URL=postgresql://user:pass@localhost:5432/knowledge_db

# --- App ---
API_SECRET_KEY=change-me                  # protects write/admin endpoints
ENVIRONMENT=development                    # development | production
